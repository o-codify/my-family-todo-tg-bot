{
  "name": "@family-todo/bot",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./bot": {
      "development": "./src/bot.ts",
      "types": "./dist/bot.d.ts",
      "default": "./dist/bot.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "dev": "tsx watch --conditions=development --env-file=../../.env src/index.ts",
    "build": "tsc -p tsconfig.json && node ../../scripts/add-js-extensions.mjs dist",
    "start": "node --env-file=../../.env dist/index.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@family-todo/shared": "workspace:*",
    "grammy": "^1.32.0",
    "pino": "^9.5.0",
    "pino-pretty": "^13.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@family-todo/config": "workspace:*",
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
