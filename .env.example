# ──────────────────────────────────────────────────────────────────────
# Family Todo — environment template
# Copy to .env (committed: NO) and adjust for your environment.
# ──────────────────────────────────────────────────────────────────────

# General
NODE_ENV=development
LOG_LEVEL=debug
TZ=Europe/Moscow

# ── Postgres ──────────────────────────────────────────────────────────
POSTGRES_USER=familytodo
POSTGRES_PASSWORD=familytodo
POSTGRES_DB=familytodo
POSTGRES_PORT=5432
# Used by API/migrations. Inside docker network: postgres:5432
DATABASE_URL=postgres://familytodo:familytodo@localhost:5432/familytodo

# ── Redis (BullMQ + cache) ────────────────────────────────────────────
REDIS_PORT=6379
# Inside docker network: redis:6379
REDIS_URL=redis://localhost:6379

# ── Photo storage (Telegram-native) ───────────────────────────────────
# Photos live in Telegram itself — the API uploads each file to the
# uploader's private chat with the bot via `sendPhoto`, and persists only
# `file_id` + `message_id` in Postgres. No S3 / MinIO needed.
# 10 MiB matches Telegram's `sendPhoto` upload cap.
PHOTO_MAX_SIZE_BYTES=10485760
PHOTO_MAX_COUNT_PER_OCCURRENCE=3
PHOTO_ALLOWED_MIME=image/jpeg,image/png,image/webp

# ── Telegram ──────────────────────────────────────────────────────────
# Create a bot via @BotFather, paste token here.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# URL where the Mini App is hosted (configured in BotFather → Menu Button)
WEBAPP_URL=http://localhost:5173
# Webhook mode (prod) — leave blank for long-polling in dev
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=

# ── API ───────────────────────────────────────────────────────────────
API_PORT=3000
API_HOST=0.0.0.0
# Used by Mini App to call the API
API_PUBLIC_URL=http://localhost:3000
# Shared secret between bot and API for server-to-server calls
INTERNAL_SERVICE_TOKEN=change-me-in-prod
# CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:5173

# ── Bot ───────────────────────────────────────────────────────────────
# In webhook mode (TELEGRAM_WEBHOOK_URL set) the bot binds an HTTP server
# here that Telegram POSTs updates to. In long-polling mode (dev default)
# these are unused.
BOT_PORT=3001
BOT_HOST=0.0.0.0
# Base URL bot uses to talk to API (inside docker: http://api:3000)
BOT_API_BASE_URL=http://localhost:3000

# ── Mini App (Vite, prefixed with VITE_) ──────────────────────────────
VITE_API_BASE_URL=http://localhost:3000
VITE_TG_BOT_USERNAME=

# ── Adminer (DB UI) ───────────────────────────────────────────────────
ADMINER_PORT=8081
# http://localhost:8081 — system: PostgreSQL, server: postgres, user/pw from above
